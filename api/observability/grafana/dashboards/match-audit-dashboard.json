{
  "uid": "top-scores-match-audit",
  "title": "top-scores API • Match Audit",
  "tags": ["top-scores", "audit", "match-health", "reconciliation"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Audit Service Up",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Down" }, "1": { "text": "Up" } }, "type": "value" }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_info)",
          "legendFormat": "audit service"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Last Audit Run",
      "gridPos": { "x": 3, "y": 0, "w": 5, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_last_success_timestamp_seconds)",
          "legendFormat": "last audit run"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Last Duration",
      "gridPos": { "x": 8, "y": 0, "w": 3, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_last_duration_seconds)",
          "legendFormat": "last duration"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Next Scheduled Run",
      "gridPos": { "x": 11, "y": 0, "w": 5, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_next_run_timestamp_seconds)",
          "legendFormat": "next scheduled run"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Matches Checked",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_matches_checked)",
          "legendFormat": "matches checked"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Matches With Issues",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_matches_with_issues)",
          "legendFormat": "matches with issues"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Issues Total",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_issues_total)",
          "legendFormat": "issues total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Healthy Matches",
      "gridPos": { "x": 4, "y": 4, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_healthy_matches)",
          "legendFormat": "healthy matches"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Report Age (s)",
      "gridPos": { "x": 8, "y": 4, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_report_age_seconds)",
          "legendFormat": "report age"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Run Failures",
      "gridPos": { "x": 12, "y": 4, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(top_scores_match_audit_run_failures_total)",
          "legendFormat": "run failures"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Current Audit Progress",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "100 * max(top_scores_match_audit_current_run_progress_ratio)",
          "legendFormat": "progress"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit Progress Over Time",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "top_scores_match_audit_current_run_matches_completed",
          "legendFormat": "matches completed"
        },
        {
          "expr": "top_scores_match_audit_current_run_matches_total",
          "legendFormat": "total matches"
        },
        {
          "expr": "top_scores_match_audit_current_run_matches_per_second",
          "legendFormat": "matches/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Current Issue Counts by Code",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "top_scores_match_audit_issue_count",
          "legendFormat": "{{code}} ({{severity}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit Coverage Stats",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "top_scores_match_audit_matches_checked",
          "legendFormat": "matches checked"
        },
        {
          "expr": "top_scores_match_audit_started_matches",
          "legendFormat": "started matches"
        },
        {
          "expr": "top_scores_match_audit_finished_expected_matches",
          "legendFormat": "expected finished"
        },
        {
          "expr": "top_scores_match_audit_detail_candidates",
          "legendFormat": "detail candidates"
        },
        {
          "expr": "rate(top_scores_match_audit_matches_audited_total[5m])",
          "legendFormat": "audited/s (5m rate)"
        }
      ]
    },
    {
      "type": "table",
      "title": "Current Issue Matches",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 12 },
      "targets": [
        {
          "expr": "top_scores_match_audit_issue_match",
          "format": "table",
          "instant": true,
          "legendFormat": "{{match_id}}"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    }
  ]
}
