{
  "uid": "top-scores-app-usage",
  "title": "Top Scores \u00b7 Audience and Usage",
  "tags": [
    "top-scores",
    "app",
    "usage",
    "performance",
    "ios"
  ],
  "timezone": "Europe/London",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 29,
      "type": "text",
      "title": "Build selection",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Showing **${build:text}** usage. Select **Debug** above to see development builds run from Xcode. **Production** shows Release/TestFlight/App Store builds. Collection health and delivery outcomes cover all builds."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Active today \u00b7 London \u00b7 ${build:text}",
      "description": "Distinct iPhone/iPad installations with recorded foreground activity for the selected build. Production excludes Xcode Debug builds. Choose Debug to inspect a development build.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(top_scores_audience_active_installations{build_type=\"$build\",job=\"top-scores\",window=\"today\"} and on(job,instance) (top_scores_audience_ready{job=\"top-scores\"} == 1))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
