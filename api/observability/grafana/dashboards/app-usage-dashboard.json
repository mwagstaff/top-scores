    {
      "id": 9,
      "type": "stat",
      "title": "Active 7 days \u00b7 week-on-week change",
      "description": "Requires at least a week of v2 collection history. Compares rolling seven-day audiences.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(top_scores_audience_active_installations{build_type=\"$build\",job=\"top-scores\",window=\"7d\"} and on(job,instance) (top_scores_audience_ready{job=\"top-scores\"} == 1)) / clamp_min(max(top_scores_audience_active_installations{build_type=\"$build\",job=\"top-scores\",window=\"7d\"} offset 7d), 1) - 1) * 100",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable"
