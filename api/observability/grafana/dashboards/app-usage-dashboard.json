    {
      "id": 5,
      "type": "timeseries",
      "title": "Active installations over time",
      "description": "Rolling distinct counts; never sum daily unique counts.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (window)(top_scores_audience_active_installations{build_type=\"$build\",job=\"top-scores\",window=~\"7d|30d\"} and on(job,instance) (top_scores_audience_ready{job=\"top-scores\"} == 1))",
          "legendFormat": "{{window}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
