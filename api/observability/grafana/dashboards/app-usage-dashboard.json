      "targets": [
        {
          "refId": "A",
          "expr": "max(top_scores_audience_events{build_type=\"$build\",job=\"top-scores\",window=\"$window\",event=\"app_open\"} and on(job,instance) (top_scores_audience_ready{job=\"top-scores\"} == 1)) / clamp_min(max(top_scores_audience_active_installations{build_type=\"$build\",job=\"top-scores\",window=\"$window\"} and on(job,instance) (top_scores_audience_ready{job=\"top-scores\"} == 1)), 1)",
