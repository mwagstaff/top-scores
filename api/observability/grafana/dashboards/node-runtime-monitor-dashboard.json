{
  "uid": "top-scores-monitor-node-runtime",
  "title": "top-scores Monitor • Node.js Runtime Health",
  "tags": [
    "top-scores",
    "nodejs",
    "runtime",
    "performance",
    "monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Process Memory",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "RSS"
        },
        {
          "expr": "process_virtual_memory_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Virtual"
        },
        {
          "expr": "nodejs_external_memory_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "External"
        },
        {
          "expr": "nodejs_array_buffers_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Array Buffers"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Heap Total"
        },
        {
          "expr": "nodejs_heap_size_physical_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Heap Physical"
        },
        {
          "expr": "nodejs_heap_size_limit_bytes{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Heap Limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * top_scores_process_cpu_usage_ratio{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event Loop Lag",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * nodejs_eventloop_lag_p50_seconds{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "p50"
        },
        {
          "expr": "1000 * nodejs_eventloop_lag_p90_seconds{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "p90"
        },
        {
          "expr": "1000 * nodejs_eventloop_lag_p99_seconds{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "p99"
        },
        {
          "expr": "1000 * nodejs_eventloop_lag_max_seconds{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event Loop Utilization",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * nodejs_eventloop_utilization_ratio{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "ELU"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active Runtime Objects",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_active_handles_total{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Handles"
        },
        {
          "expr": "nodejs_active_resources_total{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Resources"
        },
        {
          "expr": "nodejs_active_requests_total{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Requests"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Match Details Refresh Workload",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "top_scores_match_details_active_refresh_targets{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Active Targets"
        },
        {
          "expr": "top_scores_match_details_backfill_tasks{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Backfill Tasks"
        },
        {
          "expr": "top_scores_match_details_warm_tasks{job=\"top-scores\",instance=~\".*:3014\"}",
          "legendFormat": "Warm Tasks"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Spaces (Used)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_heap_space_size_used_bytes{job=\"top-scores\",instance=~\".*:3014\",space!~\"read_only_space|shared_space|shared_trusted_space|shared_large_object_space|shared_trusted_large_object_space|trusted_space|trusted_large_object_space\"}",
          "legendFormat": "{{space}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "top_scores_process_uptime_seconds{job=\"top-scores\",instance=~\".*:3014\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Server Start Date",
      "gridPos": {
        "x": 6,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "time:YYYY-MM-DD HH:mm:ss"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "1000 * process_start_time_seconds{job=\"top-scores\",instance=~\".*:3014\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap Used %",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * nodejs_heap_utilization_ratio{job=\"top-scores\",instance=~\".*:3014\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap Limit Used %",
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * nodejs_heap_limit_utilization_ratio{job=\"top-scores\",instance=~\".*:3014\"}"
        }
      ]
    }
  ]
}
