    {
      "type": "timeseries",
      "title": "TheSportsDB HTTP Latency p95",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
