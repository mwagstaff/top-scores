        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(top_scores_tsdb_http_request_duration_seconds_bucket{job=\"top-scores\",source=~\"tsdb_.*\",url=\"\"}[$__rate_interval])) by (source, le))",
          "legendFormat": "{{source}} p95"
        }
      ],
      "description": "Per-request TheSportsDB HTTP latency by client source. URL-level troubleshooting tables below use bounded top-N gauges to avoid expensive high-cardinality Prometheus scans."
