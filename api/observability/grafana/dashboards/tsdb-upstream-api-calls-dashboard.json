        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(top_scores_tsdb_http_requests_total{job=\"top-scores\",source=~\"tsdb_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval])) / clamp_min(sum(rate(top_scores_tsdb_http_requests_total{job=\"top-scores\",source=~\"tsdb_.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failure %"
        }
