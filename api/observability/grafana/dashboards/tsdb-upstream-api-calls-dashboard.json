      "targets": [
        {
          "expr": "sort_desc(sum(increase(top_scores_tsdb_http_requests_total{job=\"top-scores\",source=~\"tsdb_.*\"}[$__range])) by (source, status_code))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status_code": 1,
              "Value": 2,
              "Value #A": 2
            },
            "renameByName": {
              "source": "Source",
              "status_code": "Status Code",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        }
      ]
