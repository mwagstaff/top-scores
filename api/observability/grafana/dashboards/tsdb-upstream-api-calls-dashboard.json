    {
      "type": "table",
      "title": "Slow TheSportsDB HTTP URLs by p95 Latency",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP P95 Latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sort_desc(top_scores_tsdb_http_slow_url_p95_seconds{job=\"top-scores\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status_code": 1,
              "url": 2,
              "Value": 3,
              "Value #A": 3
            },
            "renameByName": {
              "source": "HTTP Source",
              "status_code": "Status Code",
              "url": "URL",
              "Value": "HTTP P95 Latency",
              "Value #A": "HTTP P95 Latency"
            }
          }
        }
      ],
      "description": "Top URL/status/source combinations by p95 upstream HTTP request latency over the API process rolling window. This uses bounded top-N gauges instead of querying all URL-labelled histogram buckets."
    },
    {
      "type": "table",
      "title": "Slow TheSportsDB HTTP URLs by Max Latency",
      "description": "Top 20 URL/status/source combinations by max upstream HTTP request latency over the API process rolling window. Peak Observed At is the timestamp of the max request captured by the API.",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP Max Latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak Observed At"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(top_scores_tsdb_http_slow_url_max_seconds{job=\"top-scores\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "1000 * top_scores_tsdb_http_slow_url_max_timestamp_seconds{job=\"top-scores\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "url",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status_code": 1,
              "url": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value": 3
            },
            "renameByName": {
              "source": "HTTP Source",
              "status_code": "Status Code",
              "url": "URL",
              "Value #A": "HTTP Max Latency",
              "Value #B": "Peak Observed At",
              "Value": "HTTP Max Latency"
            }
          }
        }
      ]
