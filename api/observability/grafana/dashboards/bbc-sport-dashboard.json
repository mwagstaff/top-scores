{
  "title": "BBC Sport Source Health",
  "schemaVersion": 38,
  "version": 5,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "BBC HTTP Requests - req/sec",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bbc_http_requests_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Successful Updates by Source - req/sec",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\",status=\"success\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "BBC Error Responses by Status Code - req/sec",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bbc_http_failed_responses_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__rate_interval])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Source Updates by Source - req/sec",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\",status=\"failure\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "BBC Error Counts by Response Code",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "sort_desc(sum(increase(top_scores_bbc_http_failed_responses_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__range])) by (source, status_code))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status_code": 1,
              "Value": 2,
              "Value #A": 2
            },
            "renameByName": {
              "source": "Source",
              "status_code": "Status Code",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Failed BBC URLs",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "sort_desc(topk(100, sum(increase(top_scores_bbc_http_failed_responses_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__range])) by (source, status_code, url)))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status_code": 1,
              "url": 2,
              "Value": 3,
              "Value #A": 3
            },
            "renameByName": {
              "source": "Source",
              "status_code": "Status Code",
              "url": "URL",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Sources by Count and Status",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "sort_desc(topk(20, sum(increase(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__range])) by (source, status)))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status": 1,
              "Value": 2,
              "Value #A": 2
            },
            "renameByName": {
              "source": "Source",
              "status": "Status",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Duration (All BBC Source Updates)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(source_fetch_duration_seconds_bucket{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\",status=\"success\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure Rate (% of BBC Source Updates)",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\",status=\"failure\"}[$__rate_interval])) / clamp_min(sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details|bbc_league_tables\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failure %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Earliest BBC Range Match Date",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "min(top_scores_bbc_range_match_date_timestamp_seconds{boundary=\"earliest\"} > 0) * 1000",
          "instant": true,
          "legendFormat": "earliest"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latest BBC Range Match Date",
      "gridPos": {
        "x": 6,
        "y": 44,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(top_scores_bbc_range_match_date_timestamp_seconds{boundary=\"latest\"}) * 1000",
          "instant": true,
          "legendFormat": "latest"
        }
      ]
    },
    {
      "type": "stat",
      "title": "BBC Range Scrape Running",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Idle"
                },
                "1": {
                  "text": "Running"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(top_scores_bbc_range_scrape_running)",
          "instant": true,
          "legendFormat": "running"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "BBC Range Scrape Progress",
      "gridPos": {
        "x": 18,
        "y": 44,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "100 * max by (window) (top_scores_bbc_range_scrape_progress_ratio{window=~\"past|future\"})",
          "instant": true,
          "legendFormat": "{{window}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "BBC Range Scrape Date Counts",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "max by (window) (top_scores_bbc_range_scrape_dates_total{window=~\"past|today|future|all\"})",
          "instant": true,
          "format": "table",
          "legendFormat": "total"
        },
        {
          "expr": "max by (window, result) (top_scores_bbc_range_scrape_dates_completed{window=~\"past|today|future|all\"})",
          "instant": true,
          "format": "table",
          "legendFormat": "{{result}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "renameByName": {
              "Value": "Count",
              "Value #A": "Total Dates",
              "Value #B": "Completed Dates",
              "window": "Window",
              "result": "Result"
            }
          }
        }
      ]
    }
  ]
}
