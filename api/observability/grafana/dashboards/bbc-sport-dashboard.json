{
  "title": "BBC Sport Source Health",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Successful Updates - req/sec",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"success\"}[$__rate_interval]))",
          "legendFormat": "success req/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Successful Updates by Source - req/sec",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"success\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Updates - req/sec",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"failure\"}[$__rate_interval]))",
          "legendFormat": "failure req/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Updates by Source - req/sec",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"failure\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Sources by Count and Status",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "sort_desc(topk(20, sum(increase(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\"}[$__range])) by (source, status)))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true
            },
            "indexByName": {
              "source": 0,
              "status": 1,
              "Value": 2,
              "Value #A": 2
            },
            "renameByName": {
              "source": "Source",
              "status": "Status",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Duration (All BBC Source Updates)",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(source_fetch_duration_seconds_bucket{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"success\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure Rate (% of BBC Source Updates)",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\",status=\"failure\"}[$__rate_interval])) / clamp_min(sum(rate(source_fetches_total{source=~\"bbc_live_scores|bbc_scores_fixtures_range|bbc_premier_league_table|bbc_match_details\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failure %"
        }
      ]
    }
  ]
}
