{
  "title": "Club Elo Rankings & Health",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Last Successful Club Elo Pull Duration",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "club_elo_last_success_duration_seconds{job=\"top-scores\"}",
          "legendFormat": "success duration"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Last Failed Club Elo Pull Duration",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "club_elo_last_failure_duration_seconds{job=\"top-scores\"}",
          "legendFormat": "failure duration"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Age of Oldest Club Elo Data",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - (max_over_time(club_elo_oldest_from_timestamp_seconds{job=\"top-scores\"}[30m]) > 0)",
          "legendFormat": "oldest age"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Age of Newest Club Elo Data",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - (max_over_time(club_elo_latest_from_timestamp_seconds{job=\"top-scores\"}[30m]) > 0)",
          "legendFormat": "newest age"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Teams in Latest Club Elo Pull",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#299C46"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max_over_time(club_elo_latest_pull_team_count{job=\"top-scores\"}[30m])",
          "legendFormat": "team count"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Teams Without Club Elo Match",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max_over_time(club_elo_unmatched_team_count{job=\"top-scores\"}[30m])",
          "legendFormat": "unmatched teams"
        }
      ]
    },
    {
      "type": "table",
      "title": "Club Rankings (Highest Elo First)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "expr": "sort_desc(club_elo_team_ranking_score{job=\"top-scores\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "index",
            "alias": "__rank0",
            "index": {
              "asPercentile": false
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "__rank0"
                }
              },
              "operator": "+",
              "right": {
                "fixed": "1"
              }
            },
            "alias": "#",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true,
              "__rank0": true
            },
            "indexByName": {
              "#": 0,
              "club": 1,
              "country": 2,
              "Value": 3,
              "Value #A": 3
            },
            "renameByName": {
              "#": "#",
              "club": "Club",
              "country": "Country",
              "Value": "Ranking score",
              "Value #A": "Ranking score"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Country Average Ranking Score (Highest First)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "expr": "sort_desc(club_elo_country_average_ranking_score{job=\"top-scores\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "index",
            "alias": "__rank0",
            "index": {
              "asPercentile": false
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "__rank0"
                }
              },
              "operator": "+",
              "right": {
                "fixed": "1"
              }
            },
            "alias": "#",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Metric": true,
              "metric": true,
              "__rank0": true
            },
            "indexByName": {
              "#": 0,
              "country": 1,
              "Value": 2,
              "Value #A": 2
            },
            "renameByName": {
              "#": "#",
              "country": "Country",
              "Value": "Average score",
              "Value #A": "Average score"
            }
          }
        }
      ]
    }
  ]
}
