{
  "uid": "top-scores-bsd-upstream-api-calls",
  "title": "top-scores \u2022 BSD Upstream API Calls",
  "tags": [
    "top-scores",
    "bsd",
    "upstream",
    "api"
  ],
  "timezone": "Europe/London",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "barchart",
      "title": "BSD API Calls per Day (London, Fixed Last 7 Days)",
      "description": "Europe/London calendar-day totals, including today so far. Fixed to the latest seven London dates regardless of the dashboard time picker. BSD unlimited plan: this is a volume trend, not a quota gauge.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "timeFrom": "6d/d",
      "hideTimeOverride": true,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0,
        "barWidth": 0.9,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\"}[30m]))",
          "legendFormat": "BSD API calls",
          "instant": false,
          "range": true,
          "interval": "30m"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": { "matcher": { "id": "byName", "options": "Time" } },
              "operator": "-",
              "right": { "fixed": "1" }
            },
            "alias": "Bucket time",
            "replaceFields": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "Bucket time", "destinationType": "time" }
            ]
          }
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Bucket time",
            "outputFormat": "YYYY-MM-DD",
            "timezone": "Europe/London"
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Bucket time": { "aggregations": [], "operation": "groupby" },
              "Value": { "aggregations": ["sum"], "operation": "aggregate" }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Bucket time", "desc": false }]
          }
        },
        {
          "id": "limit",
          "options": { "limitField": -7 }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": { "Bucket time": 0, "Value (sum)": 1 },
            "renameByName": { "Value (sum)": "BSD API calls" }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Good Request Rate",
      "gridPos": { "x": 0, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval]))",
          "legendFormat": "good req/sec"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bad Request Rate",
      "gridPos": { "x": 4, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval]))",
          "legendFormat": "bad req/sec"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "x": 8, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval])) / clamp_min(sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 12, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(top_scores_bsd_http_request_duration_seconds_bucket{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request Queue",
      "description": "Requests waiting for a rate-limit token or HTTP concurrency slot.",
      "gridPos": { "x": 16, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(top_scores_bsd_rate_limiter_queue_depth{job=\"top-scores\"}) + sum(top_scores_bsd_request_queue_depth{job=\"top-scores\"})",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Live Data Age",
      "description": "Seconds since the least-recent successful live-events or incidents poll.",
      "gridPos": { "x": 20, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "time() - min(top_scores_bsd_poll_last_success_timestamp_seconds{job=\"top-scores\",poll=~\"live_events|incidents\"})",
          "legendFormat": "poll age"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Good Requests (1xx-3xx) - req/sec",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Good Requests by Status Code - req/sec",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bad Requests (4xx-5xx + error) - req/sec",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bad Requests by Status Code - req/sec",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Timeout Requests - req/sec",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(top_scores_bsd_http_timeouts_total{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}"
        }
      ],
      "description": "Explicit ETIMEDOUT requests from the BSD client observer. These also appear as status_code=0 in the bad-request panels."
    },
    {
      "type": "timeseries",
      "title": "Timeout Rate (% of BSD Requests)",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(top_scores_bsd_http_timeouts_total{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])) / clamp_min(sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "timeout %"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Timeout URLs by Query String",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sort_desc(top_scores_bsd_http_timeout_url_requests{job=\"top-scores\",source=~\"bsd_.*\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "Metric": true, "metric": true },
            "indexByName": { "url": 0, "source": 1, "error_code": 2, "Value": 3, "Value #A": 3 },
            "renameByName": { "url": "URL", "source": "Source", "error_code": "Error Code", "Value": "Timeouts", "Value #A": "Timeouts" }
          }
        }
      ],
      "description": "Bounded top-N rows from the API process rolling window, retaining query strings such as league_id, status, limit, and offset."
    },
    {
      "type": "table",
      "title": "Top URLs by Query String and Status",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "sort_desc(top_scores_bsd_http_top_url_requests{job=\"top-scores\",source=~\"bsd_.*\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "Metric": true, "metric": true },
            "indexByName": { "url": 0, "source": 1, "status_code": 2, "Value": 3, "Value #A": 3 },
            "renameByName": { "url": "URL", "source": "Source", "status_code": "Status Code", "Value": "Count", "Value #A": "Count" }
          }
        }
      ],
      "description": "Full BSD upstream URLs are retained here, including query strings such as league_id, status, limit, and offset."
    },
    {
      "type": "timeseries",
      "title": "P95 Latency (All BSD Requests)",
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(top_scores_bsd_http_request_duration_seconds_bucket{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])) by (source, le))",
          "legendFormat": "{{source}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (% of BSD Requests)",
      "gridPos": { "x": 12, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\",status_code=~\"^(0|[4-5][0-9][0-9])$\"}[$__rate_interval])) / clamp_min(sum(rate(top_scores_bsd_http_requests_total{job=\"top-scores\",source=~\"bsd_.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "type": "table",
      "title": "Slow BSD URLs by p95 Latency",
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "HTTP P95 Latency" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sort_desc(top_scores_bsd_http_slow_url_p95_seconds{job=\"top-scores\",source=~\"bsd_.*\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "Metric": true, "metric": true },
            "indexByName": { "url": 0, "source": 1, "status_code": 2, "Value": 3, "Value #A": 3 },
            "renameByName": { "url": "URL", "source": "Source", "status_code": "Status Code", "Value": "HTTP P95 Latency", "Value #A": "HTTP P95 Latency" }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Slow BSD URLs by Max Latency",
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "HTTP Max Latency" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Peak Observed At" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(top_scores_bsd_http_slow_url_max_seconds{job=\"top-scores\",source=~\"bsd_.*\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "1000 * top_scores_bsd_http_slow_url_max_timestamp_seconds{job=\"top-scores\",source=~\"bsd_.*\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "url", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "__name__": true, "job": true, "instance": true, "Metric": true, "metric": true },
            "indexByName": { "url": 0, "source": 1, "status_code": 2, "Value #A": 3, "Value #B": 4, "Value": 3 },
            "renameByName": { "url": "URL", "source": "Source", "status_code": "Status Code", "Value #A": "HTTP Max Latency", "Value #B": "Peak Observed At", "Value": "HTTP Max Latency" }
          }
        }
      ]
    }
  ]
}
